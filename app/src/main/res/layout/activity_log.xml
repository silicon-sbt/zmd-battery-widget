<?xml version="1.0" encoding="utf-8"?>
<!-- 运行日志页：标题独占一行 + 按钮一行，避免标题被挤到换行、并给状态栏留出空间
     （targetSdk 35 起 Android 15+ 强制 edge-to-edge，不加 fitsSystemWindows 内容会钻到状态栏下面） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg_capsule">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/log_title"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="@font/harmonyos_sans_sc_bold"
        android:textColor="@color/accent_yellow_green"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btn_back"
            style="@style/LogChip"
            android:text="@string/log_back"/>

        <TextView
            android:id="@+id/btn_refresh"
            style="@style/LogChip"
            android:text="@string/log_refresh"/>

        <TextView
            android:id="@+id/btn_share"
            style="@style/LogChip"
            android:text="@string/log_share"/>

        <TextView
            android:id="@+id/btn_copy"
            style="@style/LogChip"
            android:text="@string/log_copy"/>

        <TextView
            android:id="@+id/btn_clear"
            style="@style/LogChip"
            android:text="@string/log_clear"/>
    </LinearLayout>

    <TextView
        android:id="@+id/log_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:fontFamily="@font/harmonyos_sans_sc_regular"
        android:textColor="@color/text_tertiary"
        android:text="@string/log_meta_placeholder"/>

    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/log_panel"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"/>
    </ScrollView>
</LinearLayout>
