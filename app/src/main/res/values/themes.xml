<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZmdCharge" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_yellow_green</item>
        <item name="colorPrimaryDark">@color/bg_capsule</item>
        <item name="colorAccent">@color/accent_yellow_green</item>
        <item name="android:windowBackground">@color/bg_capsule</item>
        <item name="android:colorBackground">@color/bg_capsule</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- 日志页顶部的胶囊小按钮 -->
    <style name="LogChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_medium</item>
        <item name="android:textColor">@color/accent_yellow_green</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
