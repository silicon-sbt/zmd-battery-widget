<?xml version="1.0" encoding="utf-8"?>
<!--
  尺寸策略：
   - minWidth=600dp / minHeight=60dp：老桌面按 dp 换算格数时，600dp 会顶满任何手机的一整行 -> 首次添加即 1×N（N=桌面横排格数）。
   - targetCellWidth=6 / targetCellHeight=1：Android 12+ 直接按"格"指定，桌面会用它自己的列数截断，同样得到 1×N 铺满。
   - minResizeWidth=160dp：允许用户长按拖动边缘把它改窄（约 2 格起）。
   Android 不开放"桌面列数"和"程序化改组件尺寸"的 API，实际格数由桌面决定，App 只能给默认值 + 运行时测量。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="600dp"
    android:minHeight="60dp"
    android:targetCellWidth="6"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:minResizeWidth="160dp"
    android:minResizeHeight="60dp"
    android:resizeMode="horizontal"
    android:initialLayout="@layout/widget_layout"
    android:widgetCategory="home_screen"
    android:description="@string/widget_desc"
    android:previewLayout="@layout/widget_layout"/>
